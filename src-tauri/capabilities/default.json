{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Windash main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/shareef01/windash" },
        { "url": "https://github.com/shareef01/windash/*" }
      ]
    }
  ]
}
