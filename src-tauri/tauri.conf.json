{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windash",
  "version": "0.1.0",
  "identifier": "com.shareef01.windash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "Windash",
        "label": "main",
        "width": 390,
        "height": 720,
        "minWidth": 280,
        "minHeight": 440,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "visible": true,
        "skipTaskbar": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {}
}
