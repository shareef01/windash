{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windash",
  "version": "0.1.0",
  "identifier": "com.shareef01.windash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Windash",
        "label": "main",
        "width": 390,
        "height": 720,
        "minWidth": 300,
        "minHeight": 440,
        "resizable": true,
        "fullscreen": false,
        "center": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": false,
        "shadow": true
      }
    ],
    "trayIcon": {
      "id": "windash-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {}
}
